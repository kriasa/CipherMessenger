{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "EnsureCreatedOnStartup": true,
    "StartupRetries": 10,
    "StartupRetryDelaySeconds": 2
  },
  "RabbitMq": {
    "HostName": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "QueueExpiresMinutes": 10080,
    "Prefetch": 16
  },
  "Limits": {
    "MaxFragmentBytes": 1048576,
    "MessageOverheadBytes": 65536,
    "SessionHours": 24
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:5000",
        "Protocols": "Http2"
      }
    }
  },
  "Security": {
    "Pbkdf2Iterations": 600000
  }
}
