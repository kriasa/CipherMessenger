{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "src.Server": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
  },
  "RabbitMq": {
    "HostName": "rabbitmq"
  },
  "Database": {
    "EnsureCreatedOnStartup": true
  }
